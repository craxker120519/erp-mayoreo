@page "/compras/nuevo"
@inherits ERP.App.Components.AuthAwareComponentBase
@using ERP.App.Dtos
@inject IErpApiClient Api
@inject NavigationManager Navigation

<PageTitle>Nueva orden de compra</PageTitle>

@if (!IsAuthenticated)
{
    <div class="alert alert-warning">Inicia sesión para crear órdenes de compra.</div>
}
else
{
    <h1>Nueva orden de compra</h1>

    <div class="btn-group mb-3" role="group">
        <button type="button" class="btn btn-sm @(tipo == TipoPedidoCompra.Inventario ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => CambiarTipo(TipoPedidoCompra.Inventario)">
            Para inventario
        </button>
        <button type="button" class="btn btn-sm @(tipo == TipoPedidoCompra.GastoInterno ? "btn-secondary" : "btn-outline-secondary")" @onclick="() => CambiarTipo(TipoPedidoCompra.GastoInterno)">
            Gasto interno (no sube a stock)
        </button>
    </div>
    @if (tipo == TipoPedidoCompra.GastoInterno)
    {
        <p class="text-muted small">Para compras que no son mercancía para revender -- equipo, papelería, servicios. No pide almacén y "Recibir" no toca inventario, solo marca la orden como cerrada/lista para pagar.</p>
    }

    <div class="row g-2 mb-3">
        <div class="col-md-4">
            <select class="form-select" @bind="proveedorId">
                <option value="">Selecciona proveedor…</option>
                @foreach (var p in proveedores)
                {
                    <option value="@p.Id">@p.Nombre</option>
                }
            </select>
        </div>
        @if (tipo == TipoPedidoCompra.Inventario && almacenes.Count > 1)
        {
            <div class="col-md-3">
                <select class="form-select" @bind="almacenId">
                    <option value="">Almacén (Principal)</option>
                    @foreach (var a in almacenes)
                    {
                        <option value="@a.Id">@a.Nombre</option>
                    }
                </select>
            </div>
        }
        <div class="col-md-5">
            <input class="form-control" placeholder="Nota (opcional)" @bind="nota" />
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body">
            @if (tipo == TipoPedidoCompra.Inventario)
            {
                <div class="row g-2">
                    <div class="col-4">
                        <select class="form-select" @bind="productoSeleccionadoId">
                            <option value="">Selecciona producto…</option>
                            @foreach (var p in productos)
                            {
                                <option value="@p.Id">@p.Nombre (@p.UnidadVenta)</option>
                            }
                        </select>
                    </div>
                    <div class="col-3">
                        <input type="number" min="0.01" step="0.01" class="form-control" @bind="cantidadAgregar" placeholder="Cantidad" />
                    </div>
                    <div class="col-3">
                        <input type="number" min="0" step="0.01" class="form-control" @bind="costoAgregar" placeholder="Costo unitario" />
                    </div>
                    <div class="col-2">
                        <button class="btn btn-outline-primary w-100" @onclick="AgregarProductoAlCarrito" disabled="@(productoSeleccionadoId is null)">Agregar</button>
                    </div>
                </div>
            }
            else
            {
                <div class="row g-2">
                    <div class="col-4">
                        <input class="form-control" placeholder="Descripción (ej. Laptop Dell Latitude)" @bind="descripcionAgregar" />
                    </div>
                    <div class="col-3">
                        <input type="number" min="0.01" step="0.01" class="form-control" @bind="cantidadAgregar" placeholder="Cantidad" />
                    </div>
                    <div class="col-3">
                        <input type="number" min="0" step="0.01" class="form-control" @bind="costoAgregar" placeholder="Costo unitario" />
                    </div>
                    <div class="col-2">
                        <button class="btn btn-outline-primary w-100" @onclick="AgregarGastoAlCarrito" disabled="@string.IsNullOrWhiteSpace(descripcionAgregar)">Agregar</button>
                    </div>
                </div>
            }
        </div>
    </div>

    <table class="table table-sm">
        <thead><tr><th>@(tipo == TipoPedidoCompra.Inventario ? "Producto" : "Descripción")</th><th>Cantidad</th><th>Costo</th><th>Importe</th><th></th></tr></thead>
        <tbody>
            @foreach (var item in carrito)
            {
                <tr>
                    <td>@item.Descripcion</td>
                    <td>@item.Cantidad @item.Unidad</td>
                    <td>@item.Costo.ToString("C")</td>
                    <td>@((item.Cantidad * item.Costo).ToString("C"))</td>
                    <td><button class="btn btn-sm btn-outline-danger" @onclick="() => carrito.Remove(item)">×</button></td>
                </tr>
            }
        </tbody>
    </table>

    <div class="d-flex justify-content-between align-items-center">
        <h4>Total: @Total.ToString("C")</h4>
        <button class="btn btn-success" @onclick="Guardar" disabled="@(guardando || proveedorId is null || carrito.Count == 0)">
            @(guardando ? "Guardando…" : "Guardar orden")
        </button>
    </div>
    @if (!string.IsNullOrWhiteSpace(mensaje))
    {
        <div class="alert alert-danger mt-2">@mensaje</div>
    }
}

@code {
    private List<Proveedor> proveedores = [];
    private List<Producto> productos = [];
    private List<Almacen> almacenes = [];
    private TipoPedidoCompra tipo = TipoPedidoCompra.Inventario;
    private int? proveedorId;
    private int? almacenId;
    private string? nota;

    private int? productoSeleccionadoId;
    private string descripcionAgregar = string.Empty;
    private decimal cantidadAgregar = 1;
    private decimal costoAgregar;
    private readonly List<(int? ProductoId, string Descripcion, string? Unidad, decimal Cantidad, decimal Costo)> carrito = [];
    private string? mensaje;
    private bool guardando;

    private decimal Total => carrito.Sum(i => i.Cantidad * i.Costo);

    protected override async Task OnInitializedAsync()
    {
        proveedores = (await Api.GetProveedoresAsync()).Where(p => p.Activo).OrderBy(p => p.Nombre).ToList();
        productos = (await Api.GetProductosAsync()).Where(p => p.Activo).OrderBy(p => p.Nombre).ToList();
        almacenes = (await Api.GetAlmacenesAsync()).Where(a => a.Activo).OrderBy(a => a.Nombre).ToList();
    }

    private void CambiarTipo(TipoPedidoCompra nuevoTipo)
    {
        if (tipo == nuevoTipo)
        {
            return;
        }

        tipo = nuevoTipo;
        carrito.Clear();
        almacenId = null;
    }

    private void AgregarProductoAlCarrito()
    {
        if (productoSeleccionadoId is not int id || cantidadAgregar <= 0)
        {
            return;
        }

        var producto = productos.First(p => p.Id == id);
        carrito.Add((producto.Id, producto.Nombre, producto.UnidadVenta, cantidadAgregar, costoAgregar));
        productoSeleccionadoId = null;
        cantidadAgregar = 1;
        costoAgregar = 0;
    }

    private void AgregarGastoAlCarrito()
    {
        if (string.IsNullOrWhiteSpace(descripcionAgregar) || cantidadAgregar <= 0)
        {
            return;
        }

        carrito.Add((null, descripcionAgregar.Trim(), null, cantidadAgregar, costoAgregar));
        descripcionAgregar = string.Empty;
        cantidadAgregar = 1;
        costoAgregar = 0;
    }

    private async Task Guardar()
    {
        if (proveedorId is not int provId || carrito.Count == 0)
        {
            mensaje = tipo == TipoPedidoCompra.Inventario
                ? "Selecciona proveedor y agrega al menos un producto."
                : "Selecciona proveedor y agrega al menos una partida.";
            return;
        }

        guardando = true;
        try
        {
            var items = carrito.Select(i => new ItemCompraRequest(i.ProductoId, i.ProductoId is null ? i.Descripcion : null, i.Cantidad, i.Costo)).ToList();
            var request = new CrearPedidoCompraRequest(provId, tipo == TipoPedidoCompra.Inventario ? almacenId : null, tipo, nota, items);
            var orden = await Api.CrearPedidoCompraAsync(request);
            Navigation.NavigateTo($"/compras/{orden.Id}");
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudo guardar la orden: {ex.Message}";
            guardando = false;
        }
    }
}
