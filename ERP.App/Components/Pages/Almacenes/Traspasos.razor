@page "/traspasos"
@inherits ERP.App.Components.AuthAwareComponentBase
@using ERP.App.Dtos
@inject IErpApiClient Api

<PageTitle>Traspasos entre almacenes</PageTitle>

<h1>Traspasos entre almacenes</h1>

@if (!IsAuthenticated)
{
    <div class="alert alert-warning">Inicia sesión para registrar traspasos.</div>
}
else if (almacenes.Count < 2)
{
    <p class="text-muted">Necesitas al menos 2 almacenes activos para traspasar mercancía entre ellos — da de alta uno en <a href="/catalogos/almacenes">Almacenes</a>.</p>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Nuevo traspaso</h5>
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label small mb-0">Origen</label>
                    <select class="form-select" @bind="origenId">
                        <option value="">Selecciona…</option>
                        @foreach (var a in almacenes)
                        {
                            <option value="@a.Id">@a.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-0">Destino</label>
                    <select class="form-select" @bind="destinoId">
                        <option value="">Selecciona…</option>
                        @foreach (var a in almacenes)
                        {
                            <option value="@a.Id">@a.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label small mb-0">Nota (opcional)</label>
                    <input class="form-control" @bind="nota" />
                </div>
            </div>

            <div class="row g-2 mt-2">
                <div class="col-5">
                    <select class="form-select" @bind="productoSeleccionadoId">
                        <option value="">Selecciona producto…</option>
                        @foreach (var p in productos)
                        {
                            <option value="@p.Id">@p.Nombre (@p.UnidadVenta)</option>
                        }
                    </select>
                </div>
                <div class="col-3">
                    <input type="number" min="0.01" step="0.01" class="form-control" @bind="cantidadAgregar" placeholder="Cantidad" />
                </div>
                <div class="col-4">
                    <button class="btn btn-outline-primary w-100" @onclick="AgregarAlCarrito" disabled="@(productoSeleccionadoId is null)">Agregar</button>
                </div>
            </div>

            @if (carrito.Count > 0)
            {
                <table class="table table-sm mt-3">
                    <thead><tr><th>Producto</th><th>Cantidad</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var item in carrito)
                        {
                            <tr>
                                <td>@item.Producto.Nombre</td>
                                <td>@item.Cantidad @item.Producto.UnidadVenta</td>
                                <td><button class="btn btn-sm btn-outline-danger" @onclick="() => carrito.Remove(item)">×</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <button class="btn btn-primary mt-2" @onclick="Guardar"
                    disabled="@(guardando || origenId is null || destinoId is null || origenId == destinoId || carrito.Count == 0)">
                @(guardando ? "Registrando…" : "Registrar traspaso")
            </button>
            @if (origenId is not null && destinoId is not null && origenId == destinoId)
            {
                <p class="text-danger small mt-1">El origen y el destino no pueden ser el mismo almacén.</p>
            }
            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="alert alert-danger mt-2 mb-0 py-1">@mensaje</div>
            }
        </div>
    </div>
}

@if (traspasos is null)
{
    <p><em>Cargando…</em></p>
}
else if (traspasos.Count == 0)
{
    <p class="text-muted">Todavía no hay traspasos registrados.</p>
}
else
{
    <table class="table table-sm table-striped align-middle">
        <thead><tr><th>Folio</th><th>Origen</th><th>Destino</th><th>Fecha</th><th>Productos</th><th></th></tr></thead>
        <tbody>
            @foreach (var t in traspasos)
            {
                <tr>
                    <td>@t.Folio</td>
                    <td>@t.AlmacenOrigen.Nombre</td>
                    <td>@t.AlmacenDestino.Nombre</td>
                    <td>@t.FechaUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@string.Join(", ", t.Items.Select(i => $"{i.Cantidad} {i.Producto.UnidadVenta} de {i.Producto.Nombre}"))</td>
                    <td><button class="btn btn-sm btn-outline-secondary" @onclick="() => DescargarPdf(t.Id, t.Folio)">PDF</button></td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<Almacen> almacenes = [];
    private List<Producto> productos = [];
    private List<TraspasoAlmacen>? traspasos;

    private int? origenId;
    private int? destinoId;
    private string? nota;
    private int? productoSeleccionadoId;
    private decimal cantidadAgregar = 1;
    private readonly List<(Producto Producto, decimal Cantidad)> carrito = [];
    private string? mensaje;
    private bool guardando;

    protected override async Task OnInitializedAsync()
    {
        almacenes = (await Api.GetAlmacenesAsync()).Where(a => a.Activo).OrderBy(a => a.Nombre).ToList();
        productos = (await Api.GetProductosAsync()).Where(p => p.Activo).OrderBy(p => p.Nombre).ToList();
        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        traspasos = (await Api.GetTraspasosAsync()).OrderByDescending(t => t.FechaUtc).ToList();
    }

    private void AgregarAlCarrito()
    {
        if (productoSeleccionadoId is not int id || cantidadAgregar <= 0)
        {
            return;
        }

        var producto = productos.First(p => p.Id == id);
        var indice = carrito.FindIndex(i => i.Producto.Id == id);
        if (indice >= 0)
        {
            carrito[indice] = (producto, carrito[indice].Cantidad + cantidadAgregar);
        }
        else
        {
            carrito.Add((producto, cantidadAgregar));
        }

        productoSeleccionadoId = null;
        cantidadAgregar = 1;
    }

    private async Task Guardar()
    {
        if (origenId is not int origen || destinoId is not int destino || origen == destino || carrito.Count == 0)
        {
            return;
        }

        guardando = true;
        try
        {
            var request = new CrearTraspasoRequest(
                origen, destino, nota, carrito.Select(i => new ItemTraspasoRequest(i.Producto.Id, i.Cantidad)).ToList());
            await Api.CrearTraspasoAsync(request);
            carrito.Clear();
            nota = null;
            mensaje = null;
            await CargarAsync();
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudo registrar el traspaso: {ex.Message}";
        }
        finally
        {
            guardando = false;
        }
    }

    private async Task DescargarPdf(int id, string folio)
    {
        try
        {
            var bytes = await Api.GetTraspasoPdfAsync(id);
            var ruta = Path.Combine(FileSystem.CacheDirectory, $"{folio}-{DateTime.Now:HHmmssfff}.pdf");
            await File.WriteAllBytesAsync(ruta, bytes);
            await Launcher.Default.OpenAsync(new OpenFileRequest("Traspaso", new ReadOnlyFile(ruta)));
        }
        catch (Exception ex)
        {
            mensaje = $"No se pudo abrir el PDF: {ex.Message}";
        }
    }
}
